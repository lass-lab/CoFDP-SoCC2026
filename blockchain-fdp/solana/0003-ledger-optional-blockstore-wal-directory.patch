diff --git a/ledger/src/blockstore_db.rs b/ledger/src/blockstore_db.rs
index db11eefbb..2ee248253 100644
--- a/ledger/src/blockstore_db.rs
+++ b/ledger/src/blockstore_db.rs
@@ -2177,6 +2177,16 @@ fn get_db_options(access_type: &AccessType) -> Options {
     // See https://github.com/facebook/rocksdb/wiki/Secondary-instance
     options.set_max_open_files(-1);
 
+    // CoFDP: COFDP_SOLANA_WAL_DIR moves the write-ahead log out of the RocksDB
+    // directory, e.g. into a P-Directory of its own so that the WAL is written
+    // with its own PID. Every process that opens the blockstore must see the
+    // same value. Unset or empty: the WAL stays in the RocksDB directory.
+    let wal_dir = std::env::var_os("COFDP_SOLANA_WAL_DIR").unwrap_or_default();
+    if !wal_dir.is_empty() {
+        info!("Blockstore WAL directory: {wal_dir:?} (COFDP_SOLANA_WAL_DIR)");
+        options.set_wal_dir(wal_dir);
+    }
+
     options
 }
 
