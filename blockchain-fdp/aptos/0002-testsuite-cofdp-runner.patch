+#!/bin/bash
+# Copyright © Aptos Foundation
+# SPDX-License-Identifier: Apache-2.0
+
+# CoFDP variant of performance_benchmark.sh.
+#
+#   --cofdp       apt-fa-transfer, 300 blocks per test (FLOW=MAINNET)
+#   --cofdp-time  apt-fa-transfer-sj: apt-fa-transfer whose block generation stops
+#                 after 530 s (FLOW=ADHOC)
+#
+# The benchmark DB (db/) and its checkpoint (cp/) are created under $COFDP_APTOS_DIR
+# (default: /home/femu/tenant0/p1), the directory tree prepared by PiDir-Binding.
+
+# Set the maximum number of file descriptors
+ulimit -n 1048576
+
+export COFDP_APTOS_DIR="${COFDP_APTOS_DIR:-/home/femu/tenant0/p1}"
+
+# Function to run the benchmark
+run_benchmark() {
+    FLOW=$1\
+    NUM_BLOCKS_PER_TEST=$2\
+    HIDE_OUTPUT=$3\
+    ENABLE_PRUNER=$4\
+    NUMBER_OF_EXECUTION_THREADS=$5\
+    SKIP_MOVE_E2E=1\
+    ./testsuite/single_node_performance.py
+}
+
+# Time-based variant: a non-zero BENCHMARK_DURATION_SECS selects the time-based
+# account sizing; the per-test duration (530 s) is set in single_node_performance.py.
+run_benchmark_time_based() {
+    FLOW=$1\
+    NUM_BLOCKS_PER_TEST=$2\
+    BENCHMARK_DURATION_SECS=$3\
+    HIDE_OUTPUT=$4\
+    ENABLE_PRUNER=$5\
+    NUMBER_OF_EXECUTION_THREADS=$6\
+    SKIP_MOVE_E2E=1\
+    ./testsuite/single_node_performance.py
+}
+
+VIRTUAL_CORES=$(getconf _NPROCESSORS_ONLN)
+
+# Both modes use 8 execution threads, whatever the number of cores.
+THREADS=8
+
+echo "Using NUMBER_OF_EXECUTION_THREADS = $THREADS (found $VIRTUAL_CORES virtual cores)"
+
+NBPT=300
+# NOTE: single_node_performance.py treats any non-empty HIDE_OUTPUT as set, so
+# HD=0 still hides the benchmark output; see CoFDP KNOWN_ISSUES (BC-11).
+HD=0
+EP=1
+
+# Check for the flag
+if [ "$1" == "--cofdp" ]; then
+    echo "Running CoFDP benchmark..."
+    run_benchmark "MAINNET" $NBPT $HD $EP $THREADS
+elif [ "$1" == "--cofdp-time" ]; then
+    echo "Running time-based apt-fa-transfer-sj benchmark (block generation stops after 530 seconds)"
+    run_benchmark_time_based "ADHOC" 1000000 1200 $HD $EP $THREADS
+else
+    echo "Usage: $0 [--cofdp | --cofdp-time]"
+    exit 1
+fi
