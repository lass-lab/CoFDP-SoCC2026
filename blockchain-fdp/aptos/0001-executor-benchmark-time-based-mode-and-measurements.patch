+
+// Execution latency of each transaction in microseconds, reported by the
+// executor benchmark. Samples are buffered per thread so that recording stays
+// lock-free; flush_thread_latencies() moves the calling thread's buffer into a
+// global list that get_all_latencies() returns.
+//
+// NOTE: only the thread calling get_all_latencies() is flushed, samples left in
+// other threads' buffers are not reported; see CoFDP KNOWN_ISSUES (BC-2).
+thread_local! {
+    static THREAD_LATENCIES: RefCell<Vec<u64>> = RefCell::new(Vec::new());
+}
+
+static AGGREGATED_LATENCIES: Lazy<Mutex<Vec<Vec<u64>>>> = Lazy::new(|| Mutex::new(Vec::new()));
+
+/// Records the execution latency of one transaction, in microseconds.
+pub fn record_task_latency_us(duration_us: u64) {
+    THREAD_LATENCIES.with(|latencies| {
+        latencies.borrow_mut().push(duration_us);
+    });
+}
+
+/// Moves the samples buffered by the calling thread into the global list.
+pub fn flush_thread_latencies() {
+    THREAD_LATENCIES.with(|latencies| {
+        let mut local_data = latencies.borrow_mut();
+        if !local_data.is_empty() {
+            if let Ok(mut aggregated) = AGGREGATED_LATENCIES.lock() {
+                aggregated.push(local_data.drain(..).collect());
+            }
+        }
+    });
+}
+
+/// Discards the samples of the calling thread and of the global list.
+pub fn reset_latency_collector() {
+    THREAD_LATENCIES.with(|latencies| {
+        latencies.borrow_mut().clear();
+    });
+
+    if let Ok(mut aggregated) = AGGREGATED_LATENCIES.lock() {
+        aggregated.clear();
+    }
+}
+
+/// Flushes the calling thread and returns all samples of the global list.
+pub fn get_all_latencies() -> Vec<u64> {
+    flush_thread_latencies();
+
+    if let Ok(aggregated) = AGGREGATED_LATENCIES.lock() {
+        let mut combined = Vec::new();
+        for thread_data in aggregated.iter() {
+            combined.extend(thread_data);
+        }
+        combined
+    } else {
+        Vec::new()
+    }
+}
