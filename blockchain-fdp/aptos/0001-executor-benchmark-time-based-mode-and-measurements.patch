+/// End of block generation for time-based runs (BENCHMARK_DURATION_SECS).
+struct GenerationDeadline {
+    start_time: Instant,
+    duration_limit: Option<Duration>,
+}
+
+impl GenerationDeadline {
+    fn new(benchmark_duration_secs: Option<u64>) -> Self {
+        Self {
+            start_time: Instant::now(),
+            duration_limit: benchmark_duration_secs.map(Duration::from_secs),
+        }
+    }
+
+    /// Returns true (and logs it) once the time limit has passed, checked before
+    /// generating block number `num_generated`.
+    fn reached(&self, num_generated: usize) -> bool {
+        match self.duration_limit {
+            Some(limit) if self.start_time.elapsed() >= limit => {
+                info!(
+                    "Time limit reached: {} seconds, generated {} blocks",
+                    limit.as_secs(),
+                    num_generated
+                );
+                true
+            },
+            _ => false,
+        }
+    }
+}
