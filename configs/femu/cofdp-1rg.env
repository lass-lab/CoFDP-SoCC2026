# The default preset with a single reclaim group (Fig. 6 and the FEMU RG = 1
# row of Fig. 14): one RG with 8 placement handles, so the 8 PIDs share all
# dies. Source it after cofdp-4rg.env, whose other values it keeps:
#   set -a; . configs/femu/cofdp-4rg.env; . configs/femu/cofdp-1rg.env; set +a
#   cd ConfFDP/build-femu && ./run-fdp.sh
rg_number=1
handle_number=8
