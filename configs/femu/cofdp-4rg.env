# SPDX-License-Identifier: GPL-2.0-only
# The paper's ConfFDP (FEMU FDP mode) preset, i.e. the defaults of
# ConfFDP/femu-scripts/run-fdp.sh, listed explicitly. Use it with
#   set -a; . configs/femu/cofdp-4rg.env; set +a
#   cd ConfFDP/build-femu && ./run-fdp.sh
# 4 reclaim groups x 2 placement handles = 8 PIDs; PID p is in RG p / 2.

# SSD geometry: 8 channels x 8 dies, 4 KiB pages, 16 MiB blocks, 64 GiB
secsz=4096
pls_per_lun=1
luns_per_ch=8
nchs=8
NAND_PAGE_SIZE_KB=4
NAND_BLOCK_SIZE_MB=16
ssd_size=65536

# FDP: reclaim groups and placement handles per reclaim group
rg_number=4
handle_number=2

# NAND latency in ns: 40 us page read, 200 us page program, 2 ms block
# erase, 25 us channel transfer per page
pg_rd_lat=40000
pg_wr_lat=200000
blk_er_lat=2000000
ch_xfer_lat=25000

# garbage collection thresholds (percent)
gc_thres_pcent=75
gc_thres_pcent_high=95

# guest: 8 vCPUs, 16 GiB
vm_smp=8
vm_mem=16G
